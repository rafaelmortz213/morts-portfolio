{
  "name": "morts-portfolio",
  "private": true,
  "version": "0.1.0",
  "description": "MORTS. portfolio: Practical Software. Thoughtful Solutions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check:config": "node scripts/check-config.mjs",
    "build": "npm run check:config && tsc -b && vite build && node scripts/postbuild.mjs",
    "scan:dist": "node scripts/scan-dist.mjs dist",
    "preview": "vite preview",
    "serve:pages-sim": "node scripts/serve-pages-sim.mjs",
    "smoke": "node scripts/smoke.mjs",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run test:scripts && npm run build && npm run scan:dist"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
