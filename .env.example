# Public build-time configuration only.
# Every VITE_ variable is embedded in the public JavaScript bundle and the
# repository is public. Never put a secret, token, password or private key in
# this file or in any VITE_ variable.

# Base path the site is served from. Must start and end with "/".
# GitHub Pages project site: https://rafaelmortz213.github.io/morts-portfolio/
VITE_BASE_PATH=/morts-portfolio/

# Later phases (not used in Phase 1). The anon/publishable key is public by
# design; the service-role key must never appear in this repository.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
